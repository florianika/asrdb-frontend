{
  "name": "asrdb-frontend",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host=0.0.0.0 --configuration development",
    "start-prod": "ng serve --host=0.0.0.0 --configuration production",
    "build": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng build --localize --configuration development",
    "build-prod": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng build --localize",
    "watch": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "localize": "ng extract-i18n --output-path src/locale/ --out-file language.xlf",
    "prod-start": "npm run build-prod && cd ./dist/asrdb-frontend && python3 -m http.server 9000",
    "lint": "eslint . --ext .ts,.html",
    "lint:fix": "eslint . --ext .ts,.html --fix",
    "check:di-scope": "node scripts/check-root-provider-collisions.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json,md}\"",
    "ci:check": "npm run check:di-scope && npm run build && npm run lint && npm run test:ci",
    "prepush": "npm run build && npm run lint"
  },
  "private": true,
  "overrides": {
    "@esri/calcite-components": "3.0.3"
  },
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/material": "^21.2.14",
    "@angular/material-moment-adapter": "21.2.14",
    "@angular/platform-browser": "^21.2.17",
    "@angular/platform-browser-dynamic": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@arcgis/core": "4.32.11",
    "@auth0/angular-jwt": "^5.1.2",
    "@fontsource/roboto": "^5.2.10",
    "angular-plotly.js": "^20.0.0",
    "bootstrap": "^5.3.8",
    "export-to-csv": "^1.4.0",
    "material-icons": "^1.13.14",
    "moment": "^2.30.1",
    "ngx-ace-wrapper": "^17.0.0",
    "ngx-editor": "^19.0.0-beta.1",
    "plotly.js-basic-dist-min": "^3.7.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.18",
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/cli": "~21.2.18",
    "@angular/compiler-cli": "^21.2.17",
    "@angular/localize": "^21.2.17",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "^6.0.0",
    "@types/plotly.js-basic-dist-min": "^2.12.4",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jasmine-core": "^6.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "prettier": "^3.9.4",
    "prettier-eslint": "^17.1.1",
    "typescript": "~5.9.3"
  }
}
